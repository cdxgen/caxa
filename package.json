{
  "name": "@cdxgen/caxa",
  "version": "4.0.0",
  "description": "Package Node.js applications into executable binaries",
  "author": "Team AppThreat <cloud@appthreat.com>",
  "homepage": "https://github.com/cdxgen/caxa",
  "bugs": "https://github.com/cdxgen/caxa/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdxgen/caxa.git"
  },
  "license": "MIT",
  "keywords": [
    "packing",
    "deployment",
    "binary"
  ],
  "exports": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "bin": {
    "caxa": "build/index.mjs"
  },
  "scripts": {
    "prepare": "npm run prepare:stubs && tsc",
    "prepare:stubs": "node scripts/build-stubs.mjs",
    "pretest": "npm run prepare:stubs",
    "test": "npm run test:lint && npm run test:stubs && npm run test:e2e",
    "test:lint": "npm run test:lint:js && npm run test:lint:rust",
    "test:lint:js": "prettier --check \"source/**/*.mts\" \"test/*.mjs\" \"bench/*.mjs\" --end-of-line auto",
    "test:lint:rust": "cargo fmt --manifest-path stubs/Cargo.toml --check && cargo clippy --manifest-path stubs/Cargo.toml --locked --all-targets -- -D warnings",
    "format": "prettier --write \"source/**/*.mts\" \"test/*.mjs\" \"bench/*.mjs\" --end-of-line auto && cargo fmt --manifest-path stubs/Cargo.toml",
    "test:stubs": "cargo test --manifest-path stubs/Cargo.toml --locked",
    "test:e2e": "node test/e2e.test.mjs"
  },
  "dependencies": {
    "@cdxgen/cdx-purl": "^0.0.4",
    "archiver": "^8.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.7.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
